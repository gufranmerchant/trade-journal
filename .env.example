# Copy this file to .env and fill in your real key. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# From your Clerk dashboard (Configure > API Keys). Secret key is server-only.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional. Real competitor books in Keyword Research. Create a free key at
# console.cloud.google.com (new project > enable "Books API" > Credentials > API key).
# Without it that section falls back to pattern descriptions.
GOOGLE_BOOKS_API_KEY=

# Optional. Reddit threads in Keyword Research ("Trending in this genre", "Recommended Reading")
# and Post Idea Finder ("Trending Right Now"), shown as posted with links - never summarised and
# never sent to any AI service (Reddit Developer Terms 7.2). Create a "script" app at
# reddit.com/prefs/apps and answer its registration questions (including any about commercial
# use) accurately. OFF BY DEFAULT: nothing happens unless REDDIT_ENABLED=1 below AND both
# credentials are set. With it off, Keyword Research and Post Idea Finder behave as if Reddit
# did not exist (no calls, no extra sections).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username, used in the User-Agent Reddit requires: web:marketer-mirror:v1.0 (by /u/NAME)
REDDIT_USERNAME=
# Master switch, off unless set to 1. Set back to 0 to disable without removing the credentials.
REDDIT_ENABLED=0
